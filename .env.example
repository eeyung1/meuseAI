# ==============================================================================
# meuseAI Configuration
# Copy this file to .env and fill in your values
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Supabase PostgreSQL or local SQLite)
# ------------------------------------------------------------------------------
# For local SQLite:
# MEUSEAI_DB_DRIVER=sqlite
# MEUSEAI_DB_DSN=meuseai_local.db

# For Supabase PostgreSQL:
# In your Supabase dashboard: Project Settings -> Database -> Connection string (URI)
# Note: meuseAI automatically isolates all its tables inside the "meuseai" schema,
# so your existing projects and public tables on Supabase are 100% untouched.
MEUSEAI_DB_DRIVER=postgres
MEUSEAI_DB_DSN=postgres://postgres:[YOUR-PASSWORD]@[YOUR-SUPABASE-HOST]:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 2. Server & Public Origin
# ------------------------------------------------------------------------------
# Address to bind (defaults to 0.0.0.0:8080)
MEUSEAI_ADDR=0.0.0.0:8080

# Public Origin URL
# For local development: http://localhost:8080
# For Render deployment: https://[YOUR-SERVICE-NAME].onrender.com
MEUSEAI_PUBLIC_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 3. Security Tokens (Must be at least 32 characters each)
# ------------------------------------------------------------------------------
# Random secret used to cryptographically sign student session cookies
MEUSEAI_SESSION_KEY=replace_with_a_random_32_character_secret_string_here!

# Independent random bearer token for administrative routes (e.g. toggle Tier 2)
MEUSEAI_ADMIN_TOKEN=replace_with_another_random_32_character_admin_token!

# ------------------------------------------------------------------------------
# 4. Paystack Monetization (Stage 2)
# ------------------------------------------------------------------------------
# Secret key from your Paystack dashboard (Settings -> API Keys & Webhooks)
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_secret_key

# ------------------------------------------------------------------------------
# 5. Email Delivery (Resend or Dry-Run)
# ------------------------------------------------------------------------------
# Set to true for local testing without sending real emails
MEUSEAI_DRY_RUN=true

# If MEUSEAI_DRY_RUN=false, configure Resend API credentials:
RESEND_API_KEY=re_replace_with_your_resend_api_key
MEUSEAI_EMAIL_FROM=meuseAI <hello@yourdomain.com>

# ------------------------------------------------------------------------------
# 6. Post-Payment Provisioning Links
# ------------------------------------------------------------------------------
MEUSEAI_LOVABLE_URL=https://lovable.dev/projects
MEUSEAI_ONBOARDING_URL=https://meuseai.com/onboarding
